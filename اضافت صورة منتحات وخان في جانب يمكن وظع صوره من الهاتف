<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المتجر - كارفور سيت سمارت</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

    <!-- Navigation Header -->
    <header class="bg-white shadow-sm p-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center max-w-xl">
            <h1 class="text-lg font-bold text-green-700">كارفور سيت سمارت</h1>
            <div class="flex gap-2">
                <a href="#" class="bg-green-700 text-white px-3 py-1.5 rounded-lg text-sm">المنتجات</a>
                <a href="#" class="bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm">السلة (0)</a>
                <a href="#" class="bg-green-100 text-green-800 px-3 py-1.5 rounded-lg text-sm font-semibold">الإدارة</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto p-4 max-w-xl">
        <div class="flex items-center gap-2 mb-6">
            <i class="fas fa-cogs text-green-700 text-xl"></i>
            <h2 class="text-xl font-bold">إدارة المتجر</h2>
        </div>

        <!-- Add Product Form Card -->
        <div class="bg-white p-5 rounded-xl shadow-sm mb-6 border border-gray-100">
            <h3 class="font-semibold text-gray-700 mb-4">إضافة منتج جديد</h3>
            
            <form id="productForm" onsubmit="addProduct(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">اسم المنتج</label>
                    <input type="text" id="productName" required placeholder="أدخل اسم المنتج" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-green-600 focus:outline-none">
                </div>

                <!-- زر اختيار الصورة من الهاتف -->
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">صورة المنتج من الهاتف</label>
                    <input type="file" id="productImageFile" accept="image/*" class="w-full p-2 border rounded-lg bg-white text-sm file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">سعر الزبون (MRU)</label>
                        <input type="number" id="priceCustomer" required placeholder="0" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-green-600 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">سعر العضو (MRU)</label>
                        <input type="number" id="priceMember" required placeholder="0" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-green-600 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">الكمية المتوفرة</label>
                    <input type="number" id="productStock" required placeholder="0" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-green-600 focus:outline-none">
                </div>

                <button type="submit" class="w-full bg-green-700 text-white py-2.5 rounded-lg font-semibold hover:bg-green-800 transition">
                    إضافة المنتج
                </button>
            </form>
        </div>

        <!-- Current Products Section -->
        <div>
            <h3 class="font-bold text-lg mb-4 text-gray-700">إدارة المنتجات الحالية</h3>
            <div id="productsList" class="space-y-3">
                <!-- المنتجات ستظهر هنا تلقائياً -->
            </div>
        </div>
    </main>

    <!-- JavaScript -->
    <script>
        let products = JSON.parse(localStorage.getItem('store_products')) || [
            {
                id: 1,
                name: 'معجون الأسنان',
                image: 'https://via.placeholder.com/150',
                priceCustomer: 550,
                priceMember: 380,
                stock: 10
            }
        ];

        function saveAndRender() {
            localStorage.setItem('store_products', JSON.stringify(products));
            renderProducts();
        }

        function addProduct(e) {
            e.preventDefault();
            
            const name = document.getElementById('productName').value;
            const priceCustomer = document.getElementById('priceCustomer').value;
            const priceMember = document.getElementById('priceMember').value;
            const stock = document.getElementById('productStock').value;
            const fileInput = document.getElementById('productImageFile');

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const imageDataUrl = event.target.result;
                    saveNewProduct(name, imageDataUrl, priceCustomer, priceMember, stock);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                saveNewProduct(name, 'https://via.placeholder.com/150', priceCustomer, priceMember, stock);
            }
        }

        function saveNewProduct(name, image, priceCustomer, priceMember, stock) {
            const newProduct = {
                id: Date.now(),
                name,
                image,
                priceCustomer,
                priceMember,
                stock
            };

            products.push(newProduct);
            saveAndRender();
            document.getElementById('productForm').reset();
        }

        function deleteProduct(id) {
            if (confirm('هل أنت متأكد من حذف هذا المنتج؟')) {
                products = products.filter(p => p.id !== id);
                saveAndRender();
            }
        }

        function renderProducts() {
            const listContainer = document.getElementById('productsList');
            if (products.length === 0) {
                listContainer.innerHTML = '<p class="text-gray-500 text-center py-4 bg-white rounded-lg shadow-sm">لا توجد منتجات حالياً.</p>';
                return;
            }

            listContainer.innerHTML = products.map(p => `
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <img src="${p.image}" alt="${p.name}" class="w-16 h-16 object-cover rounded-lg border flex-shrink-0" onerror="this.src='https://via.placeholder.com/150'">
                        <div>
                            <h4 class="font-bold text-gray-800">${p.name}</h4>
                            <p class="text-sm text-gray-600 mt-1">الزبون: ${p.priceCustomer} MRU | العضو: ${p.priceMember} MRU</p>
                            <p class="text-xs text-gray-400 mt-0.5">المتوفر: ${p.stock}</p>
                        </div>
                    </div>
                    <button onclick="deleteProduct(${p.id})" class="text-red-500 hover:text-red-700 p-2 flex-shrink-0" title="حذف المنتج">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            `).join('');
        }

        renderProducts();
    </script>
</body>
</html>
